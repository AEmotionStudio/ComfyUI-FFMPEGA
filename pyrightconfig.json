{
    "include": [
        "core",
        "skills",
        "nodes",
        "mcp"
    ],
    "exclude": [
        "**/__pycache__",
        ".venv",
        "tests",
        "core/musetalk"
    ],
    "extraPaths": [
        "."
    ],
    "venvPath": "../..",
    "venv": "venv",
    "typeCheckingMode": "basic",
    "reportMissingImports": "warning",
    "reportMissingModuleSource": "none",
    "pythonVersion": "3.13",
    "stubPath": "stubs"
}